# App
DEBUG=false
LOG_LEVEL=INFO

# API (kozocom-flow-ai backend)
API_BASE_URL=http://localhost:9000/api/v1

# GitHub App (get from https://github.com/settings/apps)
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ======================
# LLM Configuration
# ======================

# OpenRouter (Recommended - supports 200+ models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Or use direct provider keys (fallback)
# OPENAI_API_KEY=sk-xxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# App URL for OpenRouter analytics (optional)
APP_URL=https://your-domain.com

# ======================
# Database (PostgreSQL)
# ======================
# Neon example: postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# ======================
# Redis (for Celery and Cache)
# ======================
# Upstash example: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# Cache TTL in seconds (default: 300)
CONFIG_CACHE_TTL=300

# Slack (optional)
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#pr-reviews

# Sentry (optional)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ======================
# RAG - Pinecone (for context-aware reviews)
# ======================
PINECONE_API_KEY=pcsk_xxx
PINECONE_INDEX_NAME=code-reviewer

# ======================
# Embedding Provider Configuration
# ======================
# Choose provider: "gemini" (free tier) or "openai" (paid)
EMBEDDING_PROVIDER=gemini

# Google AI (for Gemini embeddings - FREE tier available)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536

# OpenAI Embedding (if using EMBEDDING_PROVIDER=openai)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1024

# ======================
# RAG Retrieval Limits
# ======================
MAX_CHANGED_FUNCTIONS=5
MAX_CALLEE_RESULTS=5
MAX_TRANSITIVE_RESULTS=3
MAX_SIBLING_RESULTS=2

# RAG Feature Flags
ENABLE_SIBLING_DETECTION=true
ENABLE_TRANSITIVE_CALLEES=true
